# Application
JOBAGENT_ENVIRONMENT=development
JOBAGENT_LOG_LEVEL=INFO
JOBAGENT_TIMEZONE=Asia/Shanghai
JOBAGENT_DATABASE_URL=postgresql+psycopg://jobagent:jobagent-dev-only@localhost:5432/jobagent

