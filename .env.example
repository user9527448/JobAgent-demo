# Application
JOBAGENT_ENVIRONMENT=development
JOBAGENT_LOG_LEVEL=INFO
JOBAGENT_TIMEZONE=Asia/Shanghai
JOBAGENT_DATABASE_URL=postgresql+psycopg://jobagent:jobagent-dev-only@localhost:5432/jobagent
JOBAGENT_ATTACHMENT_STORAGE_PATH=data/attachments
JOBAGENT_ATTACHMENT_MAX_BYTES=26214400
JOBAGENT_ATTACHMENT_CHUNK_BYTES=65536

# Destructive migration tests refuse to run unless the database name ends in _test.
JOBAGENT_TEST_DATABASE_URL=postgresql+psycopg://jobagent:jobagent-dev-only@localhost:5432/jobagent_test

# Docker Compose development database
POSTGRES_DB=jobagent
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=jobagent-dev-only

# Never add real credentials to this file.
